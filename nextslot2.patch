+		y = addToggleRow(groups.players, "Players ESP", x, y);
+		addBoolToggleRow(ch, "Next Slot Hotkey", x, y,
+			c -> c.next_slot_enabled,
+			(c, enabled) -> c.next_slot_enabled = enabled);
