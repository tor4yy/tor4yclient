+	
+	/**
+	 * Draws a billboarded (always facing the camera) label at the given
+	 * world position, similar to a vanilla entity name tag.
+	 */
+	public static void drawText(PoseStack matrices, Vec3 pos, String text,
+		int color)
+	{
+		MultiBufferSource.BufferSource vcp = getVCP();
+		Font font = MC.font;
+		
+		matrices.pushPose();
+		
+		Vec3 renderPos = pos.add(getCameraPos().reverse());
+		matrices.translate(renderPos.x, renderPos.y, renderPos.z);
+		matrices.mulPose(MC.gameRenderer.getMainCamera().rotation());
+		matrices.scale(-0.025F, -0.025F, 0.025F);
+		
+		Matrix4f matrix = matrices.last().pose();
+		float x = -font.width(text) / 2F;
+		int bgColor = (int)(0.25F * 255.0F) << 24;
+		
+		font.drawInBatch(text, x, 0, color, false, matrix, vcp,
+			Font.DisplayMode.SEE_THROUGH, bgColor, 0xF000F0);
+		
+		vcp.endBatch();
+		matrices.popPose();
+	}
 }
